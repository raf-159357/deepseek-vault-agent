		"package": "node scripts/package.mjs",
		"lint": "eslint src"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"obsidian": "^1.7.2",
		"tslib": "^2.7.0",
		"typescript": "^5.6.0"
	}
