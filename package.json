{
	"name": "deepseek-vault-agent",
	"version": "0.9.1",
	"description": "Obsidian plugin: voice-first note editing with DeepSeek",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
